# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz_1234567

# Google Gemini API Key for Free RAG (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=


# Telegram User ID of the Math Teacher (get from @userinfobot)
# Multiple IDs can be separated by commas (e.g., 123456789,987654321)
TEACHER_ADMIN_ID=123456789

# Database path (default: math_bot.db)
DATABASE_PATH=math_bot.db

# Optional: Google Sheet CSV export URL or Sheet ID for dynamic synchronization
# To get CSV URL: File -> Share -> Publish to web -> select sheet -> Comma-separated values (.csv)
GOOGLE_SHEET_CSV_URL=

# Port for Web Service healthcheck (useful for Render/Koyeb Web Services, default: 8080)
PORT=8080
ENABLE_WEB_SERVER=true
